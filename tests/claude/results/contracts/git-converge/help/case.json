{
  "id": "git-converge/help",
  "skill": "git-converge",
  "feature": "Help returns usage before repository inspection on every host",
  "invocations": {
    "claude": "/GitConverge --help",
    "codex": "$git-converge --help",
    "hermes": "/git-converge --help"
  },
  "test_object": {
    "repository": "absent",
    "arguments": [
      "--help"
    ]
  },
  "expected": [
    "Shows syntax, argument descriptions, defaults, and examples.",
    "Does not inspect or change a repository."
  ],
  "checks": [
    {
      "file": "commands/GitConverge.md",
      "contains": [
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitConverge <branch> [--apply] [--discard-ignored] [--lang <language>] [--help]`",
        "- `--help`: Show this help and stop without inspecting or changing the repository.",
        "Examples: `/GitConverge agent/release`"
      ]
    },
    {
      "file": "skills/git-converge/SKILL.md",
      "contains": [
        "- Codex: `$git-converge <branch> [--apply] [--discard-ignored] [--lang <language>] [--help]`",
        "- Hermes: `/git-converge <branch> [--apply] [--discard-ignored] [--lang <language>] [--help]`",
        "If `--help` is present, even with other arguments, answer from the inline Usage section above and stop before any tool call"
      ]
    },
    {
      "file": "references/commands.md",
      "contains": [
        "/GitConverge --help",
        "All eight commands accept `--help`."
      ]
    }
  ]
}
