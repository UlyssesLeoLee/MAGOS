{
  "arguments": [
    "<set>",
    "--into <branch>",
    "--apply",
    "--create"
  ],
  "also": [
    "lanes whose manifests overlap",
    "shared file owned by one lane",
    "spec file and sheet of at most 4096 characters",
    "record revision and base",
    "--expect-revision <n>",
    "target moved since base",
    "guard exit codes 19, 20, 21, 22, 23 and 24",
    "claim of the integration branch",
    "plain plan --amend and release of a claim of a set",
    "guard older than 1.0.4"
  ]
}
