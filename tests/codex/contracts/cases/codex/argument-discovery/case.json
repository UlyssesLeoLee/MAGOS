{
  "id": "codex/argument-discovery",
  "skill": "all",
  "feature": "Codex exposes all eight skills with compact usage hints",
  "invocations": {
    "codex": "$git-recon, $git-analyze, $git-recommend, $git-integrate, $git-cleanup, $git-converge, $git-sweep, $git-plan"
  },
  "test_object": {
    "host": "Codex CLI",
    "skills": [
      "git-recon",
      "git-analyze",
      "git-recommend",
      "git-integrate",
      "git-cleanup",
      "git-converge",
      "git-sweep",
      "git-plan"
    ]
  },
  "expected": [
    "All eight skill directories have Codex-recognized names and invocation syntax.",
    "Each openai.yaml short description includes its $skill selector and --help."
  ],
  "checks": [
    {
      "file": "skills/git-recon/SKILL.md",
      "contains": [
        "- Codex: `$git-recon [--remote] [--lang <language>] [--help]`",
        "`--help`:",
        "Examples:"
      ]
    },
    {
      "file": "skills/git-recon/agents/openai.yaml",
      "contains": [
        "$git-recon",
        "[--help]"
      ],
      "pattern": "^  short_description: \"([^\"]+)\"$",
      "length": [
        25,
        64
      ]
    },
    {
      "file": "skills/git-analyze/SKILL.md",
      "contains": [
        "- Codex: `$git-analyze <branch|worktree> [--remote] [--lang <language>] [--help]`",
        "`--help`:",
        "Examples:"
