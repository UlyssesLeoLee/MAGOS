{
  "id": "claude/argument-hints",
  "skill": "claude-commands",
  "feature": "Claude Code slash commands keep the frontmatter and inline help the / menu and --help depend on",
  "invocations": {
    "claude": "/GitRecon --help"
  },
  "test_object": {
    "commands": [
      "GitRecon",
      "GitAnalyze",
      "GitRecommend",
      "GitIntegrate",
      "GitCleanup",
      "GitConverge",
      "GitSweep",
      "GitPlan"
    ],
    "argument_hints": {
      "GitRecon": "[--remote] [--lang <language>] [--help]",
      "GitAnalyze": "<branch|worktree> [--remote] [--lang <language>] [--help]",
      "GitRecommend": "[<goal>] [--remote] [--lang <language>] [--help]",
      "GitIntegrate": "<lane|branch> [--strategy auto|merge|squash|cherry-pick] [--lang <language>] [--help]",
      "GitCleanup": "[--apply] [--lang <language>] [--help]",
      "GitConverge": "<branch> [--apply] [--discard-ignored] [--lang <language>] [--help]",
      "GitSweep": "<branch> [--apply] [--discard-ignored] [--push] [--remote <name>] [--lang <language>] [--help]",
      "GitPlan": "<set> (--into <branch> | --status | --amend | --converge | --release) [--apply] [--create] [--expect-revision <n>] [--include-active] [--land] [--lang <language>] [--help]"
    }
  },
  "expected": [
    "Each commands/Git*.md has a description and the exact argument-hint shown in the Claude Code / menu.",
    "Each command handles --help from its inline help before loading the skill.",
    "GitIntegrate, GitCleanup, GitConverge, GitSweep and GitPlan set disable-model-invocation: true so only the user can run them."
  ],
  "checks": [
    {
      "file": "commands/GitRecon.md",
      "contains": [
        "argument-hint: \"[--remote] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitRecon"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    },
    {
      "file": "commands/GitAnalyze.md",
      "contains": [
        "argument-hint: \"<branch|worktree> [--remote] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitAnalyze"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    },
    {
      "file": "commands/GitRecommend.md",
      "contains": [
        "argument-hint: \"[<goal>] [--remote] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitRecommend"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    },
    {
      "file": "commands/GitIntegrate.md",
      "contains": [
        "argument-hint: \"<lane|branch> [--strategy auto|merge|squash|cherry-pick] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitIntegrate",
        "disable-model-invocation: true"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    },
    {
      "file": "commands/GitCleanup.md",
      "contains": [
        "argument-hint: \"[--apply] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitCleanup",
        "disable-model-invocation: true"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    },
    {
      "file": "commands/GitConverge.md",
      "contains": [
        "argument-hint: \"<branch> [--apply] [--discard-ignored] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitConverge",
        "disable-model-invocation: true"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    },
    {
      "file": "commands/GitSweep.md",
      "contains": [
        "argument-hint: \"<branch> [--apply] [--discard-ignored] [--push] [--remote <name>] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitSweep",
        "disable-model-invocation: true"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    },
    {
      "file": "commands/GitPlan.md",
      "contains": [
        "argument-hint: \"<set> (--into <branch> | --status | --amend | --converge | --release) [--apply] [--create] [--expect-revision <n>] [--include-active] [--land] [--lang <language>] [--help]\"",
        "Handle `--help` first",
        "## Inline help",
        "Usage: `/GitPlan",
        "disable-model-invocation: true"
      ],
      "pattern": "^description: (.+)$",
      "length": [
        1,
        120
      ]
    }
  ]
}
