{
  "commands": [
    "GitRecon",
    "GitAnalyze",
    "GitRecommend",
    "GitIntegrate",
    "GitCleanup",
    "GitConverge",
    "GitSweep",
    "GitPlan"
  ],
  "argument_hints": {
    "GitRecon": "[--remote] [--lang <language>] [--help]",
    "GitAnalyze": "<branch|worktree> [--remote] [--lang <language>] [--help]",
    "GitRecommend": "[<goal>] [--remote] [--lang <language>] [--help]",
    "GitIntegrate": "<lane|branch> [--strategy auto|merge|squash|cherry-pick] [--lang <language>] [--help]",
    "GitCleanup": "[--apply] [--lang <language>] [--help]",
    "GitConverge": "<branch> [--apply] [--discard-ignored] [--lang <language>] [--help]",
    "GitSweep": "<branch> [--apply] [--discard-ignored] [--push] [--remote <name>] [--lang <language>] [--help]",
    "GitPlan": "<set> (--into <branch> | --status | --amend | --converge | --release) [--apply] [--create] [--expect-revision <n>] [--include-active] [--land] [--lang <language>] [--help]"
  }
}
